# ==========================================
# RecoverAI — Root Git Ignore
# ==========================================

# Dependencies
node_modules/
backend/.venv/
backend/venv/
.venv/
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Production Build Outputs
frontend/dist/
frontend/dist-ssr/
*.local

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Local Database Files
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
*.db
*.sqlite
*.sqlite3

# IDEs & System Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
